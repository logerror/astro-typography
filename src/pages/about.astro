---
import { getEntry, render } from 'astro:content'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const aboutPost = await getEntry('spec', 'about')
if (!aboutPost) {
  throw new Error('No about post found')
}
const { Content } = await render(aboutPost)
---

<LayoutDefault>
  <SiteSeo
    slot="seo"
    title="关于 Kairos · 澄明之境"
    desc="Kairos 的个人经历与关注方向：Infra、研发效能、智能驾驶、AI Infra 与投资研究。"
  />

  <header flex="~ col gap-2">
    <h1 class="post-title">
      <a class="not-prose">{aboutPost.data.title}</a>
    </h1>
  </header>
  <article class="prose">
    <Content />
  </article>
</LayoutDefault>
