---
import { themeConfig } from '~/.config'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
---

<nav class="text-center font-bold" flex="~ col gap-4">
  <ul lg="flex-col items-start text-4" class="text-3.5" flex="~ row gap-2 justify-center">
    {
      navLinks.map((nav) => (
        <li>
          <a class="" href={nav.href}>
            {t(nav.name)}
          </a>
        </li>
      ))
    }
  </ul>
  <ul flex="~ row gap-1 justify-center">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          {name === 'wechat' ? (
            <div class="social-qr">
              <span
                class="wechat-trigger not-underline-hover inline-flex items-center"
                title="微信公众号"
                role="button"
                tabindex="0"
                aria-label="显示微信公众号二维码"
              >
                <svg class="wechat-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M9.5 4C5.36 4 2 6.69 2 10c0 1.89 1.08 3.56 2.78 4.66L4 17l2.5-1.5c.89.31 1.87.5 2.91.5A5.2 5.2 0 0 1 9 14c0-3.31 3.13-6 7-6c.19 0 .38 0 .56.03C15.54 5.69 12.78 4 9.5 4m-3 2.5a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1m5 0a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1M16 9c-3.31 0-6 2.24-6 5s2.69 5 6 5c.67 0 1.31-.08 1.91-.25L20 20l-.62-1.87C20.95 17.22 22 15.71 22 14c0-2.76-2.69-5-6-5m-2 2.5a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1m4 0a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1"
                  />
                </svg>
              </span>
              <div class="qr-popover" id="wechat-qr" role="dialog" aria-label="微信公众号二维码">
                <p>扫码关注微信公众号</p>
                <img src="/wechat-qr.jpg" alt="微信公众号二维码" width="430" height="430" />
              </div>
            </div>
          ) : (
            <a href={href} target="_blank" title={name} class="not-underline-hover inline-flex items-center">
              <span class:list={[`i-mdi-${name}`, 'w-6 h-6']} aria-hidden="true" />
              <span class="sr-only">{name}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .social-qr {
    position: relative;
  }

  .wechat-trigger {
    cursor: pointer;
  }

  .wechat-icon {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--uno-colors-primary);
  }

  .qr-popover {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms ease;
  }

  .social-qr:hover .qr-popover,
  .social-qr:focus-within .qr-popover {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .qr-popover {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 0.75rem);
    right: 0;
    width: min(16rem, 80vw);
    padding: 0.75rem;
    border: 1px solid currentColor;
    background: var(--uno-colors-background);
    box-shadow: 0.35rem 0.35rem 0 var(--uno-colors-primary);
  }

  .qr-popover::after {
    position: absolute;
    right: 0;
    bottom: -0.75rem;
    width: 100%;
    height: 0.75rem;
    content: '';
  }

  .qr-popover p {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .qr-popover img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
